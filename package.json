{
  "name": "bbplanner",
  "version": "1.0.0",
  "description": "Battle Brothers planner app",
  "main": "src/index.ts",
  "private": true,
  "scripts": {
    "build": "rsbuild build",
    "serve": "rsbuild dev --open",
    "deploy": "bash scripts/uploadAssets.sh",
    "analyze": "ANALYZE=true rsbuild build",
    "format": "biome format . --write --no-errors-on-unmatched",
    "format:check": "biome format . --no-errors-on-unmatched",
    "lint:check": "biome lint . --no-errors-on-unmatched",
    "generateLegendaryImageMaps": "npx ts-node -P ./tsconfig-node.json scripts/generateLegendaryImageMaps",
    "generateLegendaryRanges": "npx ts-node -P ./tsconfig-node.json scripts/generateLegendaryRanges",
    "generateItemsById": "npx ts-node -P ./tsconfig-node.json scripts/generateItemsById",
    "postinstall": "husky install",
    "lint": "yarn run --top-level lint:check",
    "lint:fix": "biome lint . --write --unsafe --no-errors-on-unmatched"
  },
  "author": "Brent Grossman",
  "dependencies": {
    "@emotion/core": "^10.0.28",
    "@emotion/styled": "^10.0.27",
    "@material-ui/core": "^4.8.3",
    "@material-ui/icons": "^4.5.1",
    "@popmotion/popcorn": "^0.4.4",
    "array-move": "^3.0.0",
    "classcat": "^4.0.2",
    "es6-object-assign": "^1.1.0",
    "framer-motion": "^1.11.1",
    "rc-tooltip": "^4.2.1",
    "react": "^16.8.0",
    "react-dom": "^16.8.0",
    "react-select": "^3.1.0",
    "url-search-params-polyfill": "^8.1.0",
    "zustand": "^4.4.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.12",
    "@rsbuild/core": "^1.7.5",
    "@rsbuild/plugin-react": "^1.4.6",
    "@types/mkdirp": "^1.0.2",
    "@types/node": "^17.0.21",
    "@types/react": "^16.14.0",
    "@types/react-dom": "^16.8.0",
    "@types/react-select": "^3.0.16",
    "husky": "^8.0.3",
    "lint-staged": "^15.2.0",
    "mkdirp": "^1.0.4",
    "ts-node": "^10.9.1",
    "typescript": "^4.9.4"
  },
  "packageManager": "yarn@3.2.0"
}
