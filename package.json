{
  "name": "bbplanner",
  "version": "1.0.0",
  "description": "Battle Brothers planner app",
  "main": "src/index.ts",
  "private": true,
  "scripts": {
    "build": "webpack --config webpack.config.prod.js",
    "serve": "webpack-dev-server --open --config webpack.config.dev.js --hot",
    "deploy": "bash scripts/uploadAssets.sh",
    "analyze": "yarn run build --env withAnalyzer=true",
    "generateLegendaryImageMaps": "npx ts-node -P ./tsconfig-node.json scripts/generateLegendaryImageMaps",
    "generateLegendaryRanges": "npx ts-node -P ./tsconfig-node.json scripts/generateLegendaryRanges",
    "generateItemsById": "npx ts-node -P ./tsconfig-node.json scripts/generateItemsById",
    "postinstall": "husky install",
    "lint": "run-p 'lint:check--*'",
    "lint:check--es": "yarn run --top-level eslint '**/*.{js,ts,tsx}'",
    "lint:check--style": "yarn run --top-level prettier '**/*.{js,ts,tsx,scss}' --ignore-path ../../.prettierignore --check",
    "lint:fix": "run-p 'lint:fix--*'",
    "lint:fix--es": "yarn run --top-level eslint '**/*.{js,ts,tsx}' --fix",
    "lint:fix--style": "yarn run --top-level prettier '**/*.{js,ts,tsx,css,scss}' --ignore-path ../../.prettierignore --write"
  },
  "author": "Brent Grossman",
  "dependencies": {
    "@emotion/core": "^10.0.28",
    "@emotion/styled": "^10.0.27",
    "@material-ui/core": "^4.8.3",
    "@material-ui/icons": "^4.5.1",
    "@popmotion/popcorn": "^0.4.4",
    "array-move": "^3.0.0",
    "classcat": "^4.0.2",
    "es6-object-assign": "^1.1.0",
    "framer-motion": "^1.11.1",
    "rc-tooltip": "^4.2.1",
    "react": "^16.8.0",
    "react-dom": "^16.8.0",
    "react-redux": "^7.2.9",
    "react-select": "^3.1.0",
    "redux": "^4.0.5",
    "redux-thunk": "^2.3.0",
    "url-search-params-polyfill": "^8.1.0",
    "zustand": "^4.4.7"
  },
  "devDependencies": {
    "@types/mkdirp": "^1.0.2",
    "@types/node": "^17.0.21",
    "@types/react": "^16.14.0",
    "@types/react-dom": "^16.8.0",
    "@types/react-redux": "^7.1.33",
    "@types/react-select": "^3.0.16",
    "@typescript-eslint/eslint-plugin": "^5.33.0",
    "@typescript-eslint/parser": "^5.33.0",
    "aws-sdk": "^2.720.0",
    "clean-webpack-plugin": "^1.0.0",
    "css-loader": "^6.7.1",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^8.5.0",
    "eslint-plugin-import": "^2.26.0",
    "eslint-plugin-jest": "^26.1.5",
    "eslint-plugin-react": "^7.29.4",
    "eslint-plugin-react-hooks": "^4.5.0",
    "eslint-plugin-typescript-sort-keys": "^2.1.0",
    "eslint-plugin-unused-imports": "^2.0.0",
    "file-loader": "^6.2.0",
    "html-webpack-plugin": "^5.5.0",
    "husky": "^8.0.3",
    "lint-staged": "^15.2.0",
    "mkdirp": "^1.0.4",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.2.2",
    "randomstring": "^1.1.5",
    "source-map-loader": "^3.0.1",
    "style-loader": "^3.3.1",
    "ts-loader": "^9.2.6",
    "ts-node": "^10.9.1",
    "typescript": "^4.9.4",
    "webpack": "^5.89.0",
    "webpack-bundle-analyzer": "^4.3.0",
    "webpack-cli": "^4.9.2",
    "webpack-dev-server": "^4.11.1",
    "webpack-merge": "^5.0.9"
  },
  "packageManager": "yarn@3.2.0"
}
